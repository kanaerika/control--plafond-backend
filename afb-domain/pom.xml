<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.afb</groupId>
        <artifactId>transfer-platform</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>afb-domain</artifactId>
    <name>afb-domain</name>
    <description>Cœur métier pur : objets domaine, règles, ports. Aucune dépendance technique.</description>

    <!--
      RÈGLE D'OR : le domaine ne dépend de RIEN (ni Spring, ni JPA, ni web).
      C'est ce qui garantit sa pureté. On désactive même le spring-boot-maven-plugin
      car ce module ne produit pas d'exécutable, juste un jar de classes.
    -->
    <dependencies>
        <!-- Portée test uniquement : n'entre pas dans le jar, la règle d'or tient. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
