<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.afb</groupId>
        <artifactId>transfer-platform</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>afb-application</artifactId>
    <name>afb-application</name>
    <description>Cas d'usage et ports (entrée/sortie). Orchestration métier.</description>

    <!--
      L'application dépend du domaine, et du strict minimum Spring pour
      l'annotation @Service et l'injection. PAS de web, PAS de JPA ici :
      la technique reste dans l'infrastructure.
    -->
    <dependencies>
        <dependency>
            <groupId>com.afb</groupId>
            <artifactId>afb-domain</artifactId>
        </dependency>
        <dependency>
            <groupId>com.afb</groupId>
            <artifactId>afb-commons</artifactId>
        </dependency>

        <!-- Contexte Spring minimal : @Service, injection, @Transactional -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
